  <property name="styleSheet">
   <string notr="true">/* 全局窗口：柔和青绿从上到下渐变，不刺眼 */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f8fffc,
        stop:1 #edf9f4);
}

/* Tab标签栏 保持干净 */
QDialog QTabWidget::pane {
    background-color: #ffffff;
    border: none;
}
QDialog QTabBar::tab {
    background: #edf3f0;
    padding: 6px 20px;
    margin-right:3px;
    border-top-left-radius:4px;
    border-top-right-radius:4px;
}
QDialog QTabBar::tab:selected {
    background-color:#ffffff;
}

/* 分组框 */
QDialog QGroupBox {
    border:none;
    background:transparent;
    font-size:10pt;
}

/* 保留你原本不变的标签样式 */
QDialog QLabel {
    color: #222222;
    font-size: 11pt;
    min-width: 90px;
}

/* 保留你原本不变的下拉框样式 */
QDialog QComboBox {
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 4px 8px;
    background: white;
    min-height: 22px;
    font-size: 11pt;
}
QDialog QComboBox::drop-down {
    border: none;
}
/* 下拉展开选中项 改成青绿高亮 */
QDialog QComboBox QAbstractItemView {
    border: 1px solid #cccccc;
    selection-background-color: #d7f3e8;
    selection-color:#222222;
}

/* 单行输入框 同下拉框风格 */
QDialog QLineEdit {
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding:4px 6px;
    background:white;
    font-size:11pt;
}

/* 保存复选框 放大青绿风格 */
QDialog QCheckBox {
    font-size:12pt;
    spacing:8px;
}

/* 按钮 边框清晰醒目 */
QDialog QPushButton {
    min-width:130px;
    min-height:38px;
    font-size:12pt;
    border-radius:4px;
    border:1.6px solid #99bbaa;
}
QDialog QPushButton:first-of-type {
    background:#f0f7f4;
    color:#333;
}
/* 确定主按钮 加深青绿突出 */
QDialog QPushButton:last-of-type {
    background:#ccecdc;
    border-color:#77bb99;
    color:#114433;
}</string>

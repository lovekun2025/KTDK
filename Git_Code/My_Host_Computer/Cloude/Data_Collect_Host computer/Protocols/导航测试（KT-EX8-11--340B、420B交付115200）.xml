<?xml version="1.0" encoding="utf-8"?>
<protocol>
	<command1  class="Command"  type="byte" text="420B" value="55 AA"/>
	<pos0 class="Packet" text="导航数据" lenth="70">
		<HEADER value="AA 55"/>
		<count type="byte" text="计数"/>
		<status type="byte" text="状态字" unit="80:准备;65/66:对准;01:纯惯性;00:组合"/>
		<num type="byte" text="定位星数"/>
		<lon type="Int32" text="导航经度" scale="0.0000002777777778" unit="度"/>
		<lat type="Int32" text="导航纬度" scale="0.0000002777777778" unit="度"/>
		<hight type="UInt16" text="导航高度" scale="0.2" unit="米"/>
		<pitch type="Int16" text="导航俯仰角" scale="0.01" unit="度"/>
		<yaw type="UInt16" text="导航航向角" scale="0.01" unit="度"/>
		<roll type="Int16" text="导航横滚角" scale="0.01" unit="度"/>
		<velX type="Int16" text="东向速度" scale="0.006103515625"  unit="米/秒"/>
		<velY type="Int16" text="北向速度" scale="0.006103515625" unit="米/秒"/>
		<velZ type="Int16" text="天向速度" scale="0.006103515625" unit="米/秒"/>
		<gryZ type="Int16" text="Z轴角速度" scale="0.0091552734375" unit="度/秒"/>
		<gryY type="Int16" text="Y轴角速度" scale="0.0091552734375" unit="度/秒"/>
		<gryX type="Int16" text="X轴角速度" scale="0.0091552734375" unit="度/秒"/>
		<accX type="Int16" text="X轴加速度" scale="0.00897216796875" unit="米/秒2"/>
		<accY type="Int16" text="Y轴加速度" scale="0.00897216796875" unit="米/秒2"/>
		<accZ type="Int16" text="Z轴加速度" scale="0.00897216796875" unit="米/秒2"/>
		<lonGPS type="Int32" text="GPS经度" scale="0.0000002777777778" unit="度"/>
		<latGPS type="Int32" text="GPS纬度" scale="0.0000002777777778" unit="度"/>
		<hightGPS type="UInt16" text="GPS高度" scale="0.2" unit="米"/>
		<tow type="UInt32" text="周秒"/>
		<PPS type="byte" text="秒脉冲标记" unit="0x00:无效;0x01:有效"/>
		<BdStatus type="byte" text="北斗数据有效标识" unit="0x00:无效;0x01:有效"/>
		<CalibStatus type="byte" text="标定状态字" unit="0x00:未标定;0x01:开始标定;0x02:标定完成;0x03:标定失败"/>
		<DataStatus type="byte" text="数据有效标志" base="16" unit="0x44:对准;0x33:无效;0x22:纯惯性;0x11:组合"/>
		<temp type="sbyte" text="温度"/>
		<fault type="UInt16" text="故障字" base="2" unit="Bit0/Bit1:陀螺加表数据无效;Bit2:卫导数据无效"/>
		<year type="byte" text="年"/>
		<month type="byte" text="月"/>
		<day type="byte" text="日"/>
		<hour type="byte" text="时"/>
		<minute type="byte" text="分"/>
		<second type="UInt16" text="秒" scale="0.1"/>
		<Reseverd type="UInt16" text="Reseverd"/>

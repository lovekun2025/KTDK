<?xml version="1.0" encoding="utf-8"?>
<protocol>
	<pos class="Packet" text="GXPVA显示" isString="true" separator=", *" endMark="0D 0A">
		<HEADER value="$GXPVA" />
		<date type="string" text="UTC时间(yymmdd)" />
		<time type="string" text="UTC时间(hhmmss.ss)" />
		<lon type="string" text="导航纬度" />
		<lat type="string" text="导航经度" />
		<height type="string" text="海拔高" unit="米"/>
		<Ve type="string" text="东向速度" unit="米/秒"/>
		<Vn type="string" text="北向速度" unit="米/秒"/>
		<Vu type="string" text="天向速度" unit="米/秒"/>
		<Yaw type="string" text="航向角" unit="度"/>
		<Pitch type="string" text="俯仰角" unit="度"/>
		<Roll type="string" text="横滚角" unit="度"/>
		<Status type="string" text="状态位" />
		<CHECKSUM count="2" />
	</pos>
	<pos1 class="Packet" text="GXVAR显示" isString="true" separator=", *" endMark="0D 0A">
		<HEADER value="$GXVAR"/>
		<date type="string" text="UTC时间(yymmdd)" />
		<time type="string" text="UTC时间(hhmmss.ss)" />
		<lon type="string" text="X轴速度" unit="米/秒"/>
		<lat type="string" text="Y轴速度" unit="米/秒"/>
		<height type="string" text="Z轴速度" unit="米/秒"/>
		<Ve type="string" text="X轴角速度" unit="度/秒"/>
		<Vn type="string" text="Y轴角速度" unit="度/秒"/>
		<Vu type="string" text="Z轴角速度" unit="度/秒"/>
		<Yaw type="string" text="X轴加速度" unit="度/秒2"/>
		<Pitch type="string" text="Y轴加速度" unit="度/秒2"/>
		<Roll type="string" text="Z轴加速度" unit="度/秒2"/>
		<Status type="string" text="状态位" />
		<CHECKSUM count="2" />
	</pos1>
	<pos2 class="Packet" text="GXGNSS显示" isString="true" separator=", *" endMark="0D 0A">
		<HEADER value="$GXGNSS"/>
		<date type="string" text="UTC时间(yymmdd)" />
		<time type="string" text="UTC时间(hhmmss.ss)" />
		<GGA type="string" text="GGA状态" />
		<num type="string" text="卫星数目" unit="个"/>
		<s type="string" text="龄期"/>
		<lon type="string" text="经度" unit="度"/>
		<lat type="string" text="纬度" unit="度"/>
		<height1 type="string" text="海拔高度" unit="米"/>
		<height2 type="string" text="椭球高度修正" unit="米"/>
		<course type="string" text="速度航向" unit="度"/>
		<vel type="string" text="速度" unit="米/秒"/>
		<mag type="string" text="磁航角" unit="度"/>
		<douHang type="string" text="双天线航向" unit="度"/>
		<CHECKSUM count="2" />
	</pos2>
	<pos3 class="Packet" text="GBPVA显示" lenthStart="4" lenthSize="2" lenthAdd="4">
		<HEADER value="EA 52 01 01" />
		<len type="UInt16" text="帧长" />
		<count type="UInt16" text="帧计数"/>
		<time type="double" text="同步时间"/>
		<lat type="double" text="导航经度" unit="度"/>
		<lon type="double" text="导航纬度" unit="度"/>
		<height type="float" text="高程" unit="米"/>
		<Vx type="float" text="东向速度" unit="米/秒"/>
		<Vy type="float" text="北向速度" unit="米/秒"/>
		<Vz type="float" text="天向速度" unit="米/秒"/>
		<yaw type="float" text="导航航向角" unit="度"/>
		<pitch type="float" text="导航俯仰角" unit="度"/>
		<roll type="float" text="导航横滚角" unit="度"/>
		<flag type="UInt32" text="状态位" />
		<CHECKSUM start="2" end="Lenth-3"  CRC="CRC16-CCITT" count="2"/>
	</pos3>
	<pos4 class="Packet" text="GBVAR显示" lenthStart="4" lenthSize="2" lenthAdd="4">
		<HEADER value="EA 52 01 02" />
		<len type="UInt16" text="帧长" />
		<count type="UInt16" text="帧计数"/>
		<time type="double" text="同步时间"/>
		<lat type="float" text="X轴速度" unit="米/秒"/>
		<lon type="float" text="Y轴速度" unit="米/秒"/>
		<height type="float" text="Z轴速度" unit="米/秒"/>
		<Vx type="float" text="X轴加速度" unit="米/秒2"/>
		<Vy type="float" text="Y轴加速度" unit="米/秒2"/>
		<Vz type="float" text="天向加速度" unit="米/秒2"/>
		<GyroX type="float" text="X轴角速度" unit="度/秒"/>
		<GyroY type="float" text="Y轴角速度" unit="度/秒"/>
		<GyroZ type="float" text="Z轴角速度" unit="度/秒"/>
		<flag type="UInt32" text="状态位" />
		<CHECKSUM start="2" end="Lenth-3"  CRC="CRC16-CCITT" count="2"/>
	</pos4>
	<pos5 class="Packet" text="GBGNSS显示" lenthStart="4" lenthSize="2" lenthAdd="4">
		<HEADER value="EA 52 01 03" />
		<len type="UInt16" text="帧长" />
		<count type="UInt16" text="帧计数"/>
		<time type="double" text="UTC时间"/>
		<lat type="byte" text="GGA状态"/>
		<lon type="byte" text="双天线状态"/>
		<height type="byte" text="卫星数" unit="颗"/>
		<Vx type="byte" text="龄期" unit="秒"/>
		<lat type="double" text="导航经度" unit="度"/>
		<lon type="double" text="导航纬度" unit="度"/>
		<height type="float" text="海拔高度" unit="米"/>
		<height2 type="float" text="椭球高度" unit="米"/>
		<course type="float" text="速度航向" unit="度"/>
		<vel type="float" text="速度" unit="米/秒"/>
		<mag type="float" text="磁航角" unit="度"/>
		<heading type="float" text="双天线航向" unit="度"/>
		<hdop type="float" text="HDOP值"/>
		<CHECKSUM start="2" end="Lenth-3"  CRC="CRC16-CCITT" count="2"/>
	</pos5>
</protocol>